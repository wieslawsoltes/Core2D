<UserControl x:Class="Core2D.Views.Docking.Tools.ProjectExplorerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Core2D.ViewModels.Docking.Tools"
             xmlns:editor="using:Core2D.ViewModels.Editor"
             xmlns:containers="using:Core2D.Views.Containers"
             x:DataType="vm:ProjectExplorerViewModel" x:CompileBindings="True">
  <Panel DataContext="{Binding Context}">
    <Grid x:DataType="editor:ProjectEditorViewModel" RowDefinitions="Auto,*">
      <Border Padding="12,10" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1">
        <TextBlock Text="Pages &amp; layers" Classes="studio-title" />
      </Border>
      <containers:ProjectContainerView Grid.Row="1" DataContext="{Binding Project}" />
    </Grid>
  </Panel>
</UserControl>
