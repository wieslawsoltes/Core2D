<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             xmlns:vm="using:Core2D.ViewModels.Docking.Tools.Options"
             xmlns:vme="using:Core2D.ViewModels.Editor" xmlns:s="using:Core2D.Controls.Studio"
             x:Class="Core2D.Views.Docking.Tools.Options.ZoomOptionsView"
             x:DataType="vm:ZoomOptionsViewModel" x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource StudioSurfaceBrush}">
    <s:StudioPanelHeader Title="Viewport settings" Description="Inspect the active viewport and configure navigation" />
    <Panel Name="EditorContext" Grid.Row="1" DataContext="{Binding Context}">
      <ScrollViewer x:DataType="vme:ProjectEditorViewModel" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel DataContext="{Binding CanvasPlatform.Zoom}">
          <s:StudioSection x:DataType="paz:ZoomBorder" Header="Transform">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <s:StudioReadout Label="Horizontal scale" Value="{Binding ZoomX, StringFormat='{}{0:G6}'}" />
                <s:StudioReadout Grid.Column="1" Label="Vertical scale" Value="{Binding ZoomY, StringFormat='{}{0:G6}'}" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <s:StudioReadout Label="Horizontal offset" Value="{Binding OffsetX, StringFormat='{}{0:G6}'}" />
                <s:StudioReadout Grid.Column="1" Label="Vertical offset" Value="{Binding OffsetY, StringFormat='{}{0:G6}'}" />
              </Grid>
              <WrapPanel DataContext="{Binding #EditorContext.DataContext}" x:DataType="vme:ProjectEditorViewModel">
                <Button Content="Reset" Command="{Binding Platform.OnZoomReset}" Margin="0,0,4,4" />
                <Button Content="Fill" Command="{Binding Platform.OnZoomFill}" Margin="0,0,4,4" />
                <Button Content="Fit" Command="{Binding Platform.OnZoomUniform}" Margin="0,0,4,4" />
                <Button Content="Cover" Command="{Binding Platform.OnZoomUniformToFill}" Margin="0,0,4,4" />
                <Button Content="Auto fit" Command="{Binding Platform.OnZoomAutoFit}" Margin="0,0,4,4" />
              </WrapPanel>
            </StackPanel>
          </s:StudioSection>
          <s:StudioSection x:DataType="paz:ZoomBorder" Header="Navigation">
            <StackPanel Spacing="8">
              <s:StudioPropertyRow Label="Pan button"><ComboBox ItemsSource="{x:Static paz:ZoomBorder.ButtonNames}" SelectedItem="{Binding PanButton, Mode=TwoWay}" HorizontalAlignment="Stretch" /></s:StudioPropertyRow>
              <s:StudioPropertyRow Label="Stretch"><ComboBox ItemsSource="{x:Static paz:ZoomBorder.StretchModes}" SelectedItem="{Binding Stretch, Mode=TwoWay}" HorizontalAlignment="Stretch" /></s:StudioPropertyRow>
              <s:StudioPropertyRow Label="Zoom speed"><s:StudioNumericField Value="{Binding ZoomSpeed, Mode=TwoWay}" Minimum="0.01" Maximum="100" Increment="0.1" AutomationProperties.Name="Zoom speed" /></s:StudioPropertyRow>
              <s:StudioSettingToggle Content="Allow panning" Description="Move the viewport without changing document geometry." IsChecked="{Binding EnablePan, Mode=TwoWay}" />
              <s:StudioSettingToggle Content="Allow zooming" Description="Enable pointer and gesture zoom in the active viewport." IsChecked="{Binding EnableZoom, Mode=TwoWay}" />
            </StackPanel>
          </s:StudioSection>
          <s:StudioSection x:DataType="paz:ZoomBorder" Header="Constraints" IsExpanded="False">
            <StackPanel Spacing="8">
              <s:StudioSettingToggle Content="Constrain viewport" Description="Apply the existing scale and offset limits below." IsChecked="{Binding EnableConstrains, Mode=TwoWay}" />
              <!-- Keep text conversion for existing infinite/unbounded limits. -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <s:StudioPropertyField Label="Min horizontal scale"><TextBox Text="{Binding MinZoomX, Mode=TwoWay}" /></s:StudioPropertyField>
                <s:StudioPropertyField Grid.Column="1" Label="Max horizontal scale"><TextBox Text="{Binding MaxZoomX, Mode=TwoWay}" /></s:StudioPropertyField>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <s:StudioPropertyField Label="Min vertical scale"><TextBox Text="{Binding MinZoomY, Mode=TwoWay}" /></s:StudioPropertyField>
                <s:StudioPropertyField Grid.Column="1" Label="Max vertical scale"><TextBox Text="{Binding MaxZoomY, Mode=TwoWay}" /></s:StudioPropertyField>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <s:StudioPropertyField Label="Min horizontal offset"><TextBox Text="{Binding MinOffsetX, Mode=TwoWay}" /></s:StudioPropertyField>
                <s:StudioPropertyField Grid.Column="1" Label="Max horizontal offset"><TextBox Text="{Binding MaxOffsetX, Mode=TwoWay}" /></s:StudioPropertyField>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <s:StudioPropertyField Label="Min vertical offset"><TextBox Text="{Binding MinOffsetY, Mode=TwoWay}" /></s:StudioPropertyField>
                <s:StudioPropertyField Grid.Column="1" Label="Max vertical offset"><TextBox Text="{Binding MaxOffsetY, Mode=TwoWay}" /></s:StudioPropertyField>
              </Grid>
            </StackPanel>
          </s:StudioSection>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </Grid>
</UserControl>
