<UserControl x:Class="Core2D.Views.Docking.Tools.Properties.PagePropertiesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio"
             xmlns:vm="using:Core2D.ViewModels.Docking.Tools.Properties"
             xmlns:editor="using:Core2D.ViewModels.Editor"
             x:DataType="vm:PagePropertiesViewModel" x:CompileBindings="True">
  <Panel DataContext="{Binding Context}">
    <ScrollViewer x:DataType="editor:ProjectEditorViewModel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <s:StudioSection Header="Page settings">
        <ContentControl Content="{Binding Project.CurrentContainer}" />
      </s:StudioSection>
    </ScrollViewer>
  </Panel>
</UserControl>
