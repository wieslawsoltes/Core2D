<UserControl x:Class="Core2D.Views.Docking.Tools.Properties.StylePropertiesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio"
             xmlns:converters="using:Core2D.Converters"
             xmlns:vm="using:Core2D.ViewModels.Docking.Tools.Properties"
             xmlns:editor="using:Core2D.ViewModels.Editor"
             x:DataType="vm:StylePropertiesViewModel" x:CompileBindings="True">
  <Panel DataContext="{Binding Context}">
    <ScrollViewer x:DataType="editor:ProjectEditorViewModel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <s:StudioSection Header="Appearance">
        <Panel>
          <ContentControl Content="{Binding Project.SelectedShapes, Converter={x:Static converters:SelectedShapesFirstItemStyleValueConverter.Instance}}"
                          IsVisible="{Binding Project.SelectedShapes, Converter={x:Static converters:SelectedShapesHasItemsValueConverter.Instance}}" />
          <ContentControl Content="{Binding Project.CurrentStyleLibrary.Selected}"
                          IsVisible="{Binding Project.SelectedShapes, Converter={x:Static converters:SelectedShapesIsEmptyValueConverter.Instance}}" />
        </Panel>
      </s:StudioSection>
    </ScrollViewer>
  </Panel>
</UserControl>
