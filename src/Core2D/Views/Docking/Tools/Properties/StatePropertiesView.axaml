<UserControl x:Class="Core2D.Views.Docking.Tools.Properties.StatePropertiesView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Docking.Tools.Properties"
             xmlns:editor="using:Core2D.ViewModels.Editor" xmlns:c="using:Core2D.Converters"
             x:DataType="vm:StatePropertiesViewModel" x:CompileBindings="True">
  <Panel DataContext="{Binding Context}">
    <Grid x:DataType="editor:ProjectEditorViewModel" s:StudioEditContext.History="{Binding Project.History}">
      <s:StudioShapeStateEditor Selection="{Binding Project.SelectedShapes}"
                               IsVisible="{Binding Project.SelectedShapes, Converter={x:Static c:SelectedShapesHasItemsValueConverter.Instance}}" />
      <s:StudioEmptyState Title="Select an object" Description="Object behavior, output and connection flags appear here."
                          IsVisible="{Binding Project.SelectedShapes, Converter={x:Static c:SelectedShapesIsEmptyValueConverter.Instance}}" />
    </Grid>
  </Panel>
</UserControl>
