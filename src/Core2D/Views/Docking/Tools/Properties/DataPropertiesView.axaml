<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:Core2D.Views.Data" xmlns:s="using:Core2D.Controls.Studio"
             xmlns:c="using:Core2D.Converters" xmlns:vm="using:Core2D.ViewModels.Docking.Tools.Properties"
             xmlns:editor="using:Core2D.ViewModels.Editor" x:Class="Core2D.Views.Docking.Tools.Properties.DataPropertiesView"
             x:DataType="vm:DataPropertiesViewModel" x:CompileBindings="True">
  <Panel DataContext="{Binding Context}">
    <Grid x:DataType="editor:ProjectEditorViewModel" s:StudioEditContext.History="{Binding Project.History}">
      <data:DataObjectView DataContext="{Binding Project.SelectedShapes, Converter={x:Static c:SelectedShapesFirstItemValueConverter.Instance}}"
                           IsVisible="{Binding Project.SelectedShapes, Converter={x:Static c:SelectedShapesHasItemsValueConverter.Instance}}" />
      <s:StudioEmptyState Title="Select an object" Description="Inspect linked data and custom properties for your selection."
                          IsVisible="{Binding Project.SelectedShapes, Converter={x:Static c:SelectedShapesIsEmptyValueConverter.Instance}}" />
    </Grid>
  </Panel>
</UserControl>
