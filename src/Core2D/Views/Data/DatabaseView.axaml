<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:app="using:Core2D"
  xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:idd="using:Avalonia.Xaml.Interactions.DragAndDrop"
  xmlns:behaviors="using:Core2D.Behaviors" xmlns:vmdt="using:Core2D.ViewModels.Data"
  xmlns:vmd="using:Core2D.ViewModels.Designer" xmlns:s="using:Core2D.Controls.Studio"
  x:Class="Core2D.Views.Data.DatabaseView" mc:Ignorable="d" d:DataContext="{x:Static vmd:DesignerContext.Database}"
  d:DesignWidth="250" d:DesignHeight="400" x:DataType="vmdt:DatabaseViewModel" x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource StudioSurfaceBrush}">
    <s:StudioPanelHeader Title="Database" Description="Edit records, apply data and manage columns"/>
    <TabControl Grid.Row="1">
      <TabItem Header="Records">
        <DockPanel>
          <Grid RowDefinitions="*" ColumnDefinitions="*,Auto" Margin="{DynamicResource ContentMargin}" DockPanel.Dock="Top">
            <s:StudioSearchBox Text="{Binding RecordFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Watermark="Filter records" BorderBrush="Transparent" VerticalAlignment="Center"
              Margin="0,0,0,0" Grid.Column="0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Content="Apply" Command="{Binding ApplyRecord}" CommandParameter="{Binding CurrentRecord}"
                IsVisible="{Binding !!CurrentRecord}" BorderBrush="Transparent" Background="Transparent"
                Padding="8,5" />
              <Button Content="Remove" Command="{Binding RemoveRecord}" CommandParameter="{Binding CurrentRecord}"
                IsVisible="{Binding !!CurrentRecord}" BorderBrush="Transparent" Background="Transparent"
                Padding="8,5" />
              <Button Content="Add" Command="{Binding AddRecord}" CommandParameter="{Binding}" BorderBrush="Transparent"
                Background="Transparent" Padding="8,5" />
            </StackPanel>
          </Grid>
          <DataGrid x:Name="RowsDataGrid" SelectedItem="{Binding CurrentRecord, Mode=TwoWay}" SelectionMode="Single"
            AutoGenerateColumns="False" IsReadOnly="False" CanUserReorderColumns="False"
            CanUserResizeColumns="True" CanUserSortColumns="True" BorderThickness="0"
            RowBackground="Transparent">
            <i:Interaction.Behaviors>
              <idd:TypedDragBehavior DataType="{x:Type vmdt:RecordViewModel}"/>
              <behaviors:DatabaseRecordsGridBehavior/>
            </i:Interaction.Behaviors>
            <DataGrid.KeyBindings>
              <KeyBinding Command="{Binding AddRecord}"
                CommandParameter="{Binding #RowsDataGrid.DataContext, Mode=OneWay}"
                Gesture="{app:PlatformGesture Text=Primary+N}" />
              <KeyBinding Command="{Binding RemoveRecord}" CommandParameter="{Binding #RowsDataGrid.SelectedItem}" Gesture="Delete"/>
            </DataGrid.KeyBindings>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Current Record">
        <ContentControl Content="{Binding CurrentRecord}"/>
      </TabItem>
      <TabItem Header="Columns">
        <DockPanel>
          <Grid RowDefinitions="*" ColumnDefinitions="*,Auto" Margin="{DynamicResource ContentMargin}" DockPanel.Dock="Top">
            <s:StudioSearchBox Text="{Binding ColumnFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Watermark="Filter columns" BorderBrush="Transparent" VerticalAlignment="Center"
              Margin="0,0,0,0" Grid.Column="0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Content="Remove" Command="{Binding RemoveColumn}"
                CommandParameter="{Binding #ColumnsDataGrid.SelectedItem}" BorderBrush="Transparent"
                Background="Transparent" Padding="8,5" />
              <Button Content="Add" Command="{Binding AddColumn}" CommandParameter="{Binding}" BorderBrush="Transparent"
                Background="Transparent" Padding="8,5" />
            </StackPanel>
          </Grid>
          <DataGrid x:Name="ColumnsDataGrid" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="False"
            CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
            BorderThickness="0" RowBackground="Transparent">
            <i:Interaction.Behaviors>
              <idd:TypedDragBehavior DataType="{x:Type vmdt:ColumnViewModel}"/>
              <behaviors:DatabaseColumnsGridBehavior/>
            </i:Interaction.Behaviors>
            <DataGrid.KeyBindings>
              <KeyBinding Command="{Binding AddColumn}" CommandParameter="{Binding}" Gesture="{app:PlatformGesture Text=Primary+N}"/>
              <KeyBinding Command="{Binding RemoveColumn}" CommandParameter="{Binding #ColumnsDataGrid.SelectedItem}" Gesture="Delete"/>
            </DataGrid.KeyBindings>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
