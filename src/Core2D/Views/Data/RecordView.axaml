<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Data"
             x:Class="Core2D.Views.Data.RecordView" x:DataType="vm:RecordViewModel" x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource StudioSurfaceBrush}">
    <s:StudioPanelHeader Title="Record values" Description="Names and values stay paired while searching and sorting" />
    <s:StudioDataTable Grid.Row="1" Source="{Binding}" />
  </Grid>
</UserControl>
