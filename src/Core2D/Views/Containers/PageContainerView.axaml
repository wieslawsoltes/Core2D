<UserControl x:Class="Core2D.Views.Containers.PageContainerView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:data="using:Core2D.Views.Data"
             xmlns:vm="using:Core2D.ViewModels.Containers"
             x:DataType="vm:PageContainerViewModel" x:CompileBindings="True">
  <StackPanel>
    <ContentControl Content="{Binding Template}" />
    <s:StudioSection Header="Page data" IsExpanded="False">
      <data:DataObjectView />
    </s:StudioSection>
  </StackPanel>
</UserControl>
