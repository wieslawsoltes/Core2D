<UserControl x:Class="Core2D.Views.Containers.LayerContainerView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Containers"

             x:DataType="vm:LayerContainerViewModel" x:CompileBindings="True">
  <StackPanel>
    <s:StudioSection Header="Layer">
      <StackPanel Spacing="8">
        <s:StudioNameField Value="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="Layer name" />
        <s:StudioSwitch Content="Visible" IsChecked="{Binding IsVisible, Mode=TwoWay}" />
      </StackPanel>
    </s:StudioSection>
    <s:StudioCollectionInspector Title="Layer objects" Items="{Binding Shapes}" />
  </StackPanel>
</UserControl>
