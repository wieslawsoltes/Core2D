<UserControl x:Class="Core2D.Views.Containers.TemplateContainerView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:data="using:Core2D.Views.Data"
             xmlns:renderer="using:Core2D.Views.Renderer" xmlns:vm="using:Core2D.ViewModels.Containers"
             x:DataType="vm:TemplateContainerViewModel" x:CompileBindings="True">
  <StackPanel>
    <s:StudioSection Header="Layout">
      <Grid ColumnDefinitions="*,6,*">
        <s:StudioNumberBox Prefix="W" Text="{Binding Width, Mode=TwoWay}" AutomationProperties.Name="Page width" />
        <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
        <s:StudioNumberBox Grid.Column="2" Prefix="H" Text="{Binding Height, Mode=TwoWay}" AutomationProperties.Name="Page height" />
      </Grid>
    </s:StudioSection>
    <s:StudioSection Header="Page fill">
      <ContentControl Content="{Binding Background}" />
    </s:StudioSection>
    <s:StudioSection Header="Layout grid" IsExpanded="False">
      <renderer:GridView />
    </s:StudioSection>
    <s:StudioSection Header="Template data" IsExpanded="False">
      <data:DataObjectView />
    </s:StudioSection>
  </StackPanel>
</UserControl>
