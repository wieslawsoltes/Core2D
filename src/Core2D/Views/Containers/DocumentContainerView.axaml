<UserControl x:Class="Core2D.Views.Containers.DocumentContainerView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Containers"

             x:DataType="vm:DocumentContainerViewModel" x:CompileBindings="True">
  <StackPanel>
    <s:StudioSection Header="Document">
      <s:StudioNameField Value="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="Document name" />
    </s:StudioSection>
    <s:StudioCollectionInspector Title="Pages" Items="{Binding Pages}" />
  </StackPanel>
</UserControl>
