<UserControl x:Class="Core2D.Views.Containers.ProjectContainerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Core2D"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:idd="using:Avalonia.Xaml.Interactions.DragAndDrop"
             xmlns:dd="using:Core2D.Behaviors.DragAndDrop"
             xmlns:behaviors="using:Core2D.Behaviors"
             xmlns:converters="using:Core2D.Converters"
             xmlns:vmc="using:Core2D.ViewModels.Containers"
             xmlns:vms="using:Core2D.ViewModels.Shapes"
             xmlns:c="using:Core2D.Controls"
             xmlns:s="using:Core2D.Controls.Studio"
             x:DataType="vmc:ProjectContainerViewModel" x:CompileBindings="True">
  <i:Interaction.Behaviors><behaviors:StudioHierarchyActionsBehavior /></i:Interaction.Behaviors>
  <UserControl.Resources>
    <dd:ProjectDataGridDropHandler x:Key="ProjectDataGridDropHandler" />
    <ContextMenu x:Key="ProjectContainerContextMenu" x:DataType="vmc:ProjectContainerViewModel">
      <MenuItem Header="_Add Document" Command="{Binding AddDocument}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="E_xport" Command="{Binding ExportCommand}" CommandParameter="{Binding Mode=OneWay}" />
    </ContextMenu>
    <ContextMenu x:Key="DocumentContainerContextMenu" x:DataType="vmc:DocumentContainerViewModel">
      <MenuItem Header="_Add Page" Command="{Binding AddPage}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="Insert Document Bef_ore" Command="{Binding InsertDocumentBefore}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="Insert Document Aft_er" Command="{Binding InsertDocumentAfter}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="Cu_t" Command="{Binding CutCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="_Copy" Command="{Binding CopyCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="_Paste" Command="{Binding PasteCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="E_xport" Command="{Binding ExportCommand}" CommandParameter="{Binding Mode=OneWay}" />
    </ContextMenu>
    <ContextMenu x:Key="PageContainerContextMenu" x:DataType="vmc:PageContainerViewModel">
      <MenuItem Header="Insert Page Bef_ore" Command="{Binding InsertPageBefore}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="Insert Page Aft_er" Command="{Binding InsertPageAfter}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="Cu_t" Command="{Binding CutCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="_Copy" Command="{Binding CopyCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="_Paste" Command="{Binding PasteCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="E_xport" Command="{Binding ExportCommand}" CommandParameter="{Binding Mode=OneWay}" />
    </ContextMenu>
    <ContextMenu x:Key="LayerContainerContextMenu" x:DataType="vmc:LayerContainerViewModel">
      <MenuItem Header="_Add Layer" Command="{Binding AddLayer}" CommandParameter="{Binding Owner, Mode=OneWay}" />
      <Separator />
      <MenuItem Header="Cu_t" Command="{Binding CutCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="_Copy" Command="{Binding CopyCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="_Paste" Command="{Binding PasteCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="_Delete" Command="{Binding RemoveLayer}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="E_xport" Command="{Binding ExportCommand}" CommandParameter="{Binding Mode=OneWay}" />
    </ContextMenu>
    <ContextMenu x:Key="BaseShapeContextMenu" x:DataType="vms:BaseShapeViewModel">
      <MenuItem Header="Cu_t" Command="{Binding CutCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="_Copy" Command="{Binding CopyCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <MenuItem Header="_Paste" Command="{Binding PasteCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding Mode=OneWay}" />
      <Separator />
      <MenuItem Header="E_xport" Command="{Binding ExportCommand}" CommandParameter="{Binding Mode=OneWay}" />
    </ContextMenu>
  </UserControl.Resources>
  <DockPanel s:StudioEditContext.History="{Binding History}">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="{DynamicResource ContentMargin}">
      <s:StudioNameField Value="{Binding Name, Mode=TwoWay}" BorderBrush="Transparent" Background="Transparent"
               VerticalAlignment="Center" AutomationProperties.Name="Project name" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <s:StudioIconButton Icon="M3,3H13V4H3Z M5,1H11V2H5Z M4,5H12V15H4Z M5,6V14H11V6Z"
                            Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}"
                            IsVisible="{Binding !!Selected}" ToolTip.Tip="Delete selected item" AutomationProperties.Name="Delete selected item" />
        <s:StudioIconButton Icon="M1,7H15V9H1Z M7,1H9V15H7Z" Command="{Binding New}"
                            CommandParameter="{Binding Selected}" ToolTip.Tip="Add document, page or layer" AutomationProperties.Name="Add project item" />
      </StackPanel>
    </Grid>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,0,6,6">
      <TextBlock Text="Pages &amp; layers" FontWeight="SemiBold" VerticalAlignment="Center" />
      <s:StudioIconButton Grid.Column="1" Name="RevealLayer" Icon="M7,0H9V3H7Z M7,13H9V16H7Z M0,7H3V9H0Z M13,7H16V9H13Z M8,4A4,4 0 1 1 7.99,4Z M8,6A2,2 0 1 0 8.01,6Z" ToolTip.Tip="Reveal selected item" AutomationProperties.Name="Reveal selected item" />
      <s:StudioIconButton Grid.Column="2" Name="ExpandLayers" Icon="M2,3H14V5H2Z M4,7H12V9H4Z M6,11H10V13H6Z" ToolTip.Tip="Expand all layers" AutomationProperties.Name="Expand all layers" />
      <s:StudioIconButton Grid.Column="3" Name="CollapseLayers" Icon="M2,7H14V9H2Z" ToolTip.Tip="Collapse all layers" AutomationProperties.Name="Collapse all layers" />
    </Grid>
    <DataGrid x:Name="DocumentsDataGrid" Classes="studio-layer-grid" RowHeight="30"
              SelectedItem="{Binding Selected, Mode=TwoWay}"
              SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              HeadersVisibility="None" GridLinesVisibility="None" BorderThickness="0"
              RowBackground="Transparent" ContextMenu="{StaticResource ProjectContainerContextMenu}">
      <i:Interaction.Behaviors>
        <idd:ContextDropBehavior Context="{Binding FallbackValue={x:Null}}" Handler="{StaticResource ProjectDataGridDropHandler}" />
        <behaviors:ProjectDocumentsGridBehavior />
        <behaviors:StudioScopedKeyBindingsBehavior />
      </i:Interaction.Behaviors>
      <DataGrid.KeyBindings>
        <KeyBinding Command="{Binding New}" CommandParameter="{Binding #DocumentsDataGrid.SelectedItem}" Gesture="{app:PlatformGesture Text=Primary+N}" />
        <KeyBinding Command="{Binding CutCommand}" CommandParameter="{Binding #DocumentsDataGrid.SelectedItem}" Gesture="{app:PlatformGesture Text=Primary+X}" />
        <KeyBinding Command="{Binding CopyCommand}" CommandParameter="{Binding #DocumentsDataGrid.SelectedItem}" Gesture="{app:PlatformGesture Text=Primary+C}" />
        <KeyBinding Command="{Binding PasteCommand}" CommandParameter="{Binding #DocumentsDataGrid.SelectedItem}" Gesture="{app:PlatformGesture Text=Primary+V}" />
        <KeyBinding Command="{Binding DeleteCommand}" CommandParameter="{Binding #DocumentsDataGrid.SelectedItems}" Gesture="Delete" />
        <KeyBinding Command="{Binding ExportCommand}" CommandParameter="{Binding #DocumentsDataGrid.SelectedItem}" Gesture="{app:PlatformGesture Text=Primary+E}" />
      </DataGrid.KeyBindings>
      <DataGrid.Resources>
        <DataTemplate x:Key="ProjectDocumentsCellTemplate" x:DataType="x:Object">
          <ContentPresenter Content="{Binding}" />
        </DataTemplate>
      </DataGrid.Resources>
      <DataGrid.DataTemplates>
        <DataTemplate DataType="vmc:DocumentContainerViewModel" x:DataType="vmc:DocumentContainerViewModel">
          <s:StudioLayerRow Glyph="M2,0H11L15,4V16H2Z M4,2V14H13V5H10V2Z" ContextMenu="{StaticResource DocumentContainerContextMenu}" />
        </DataTemplate>
        <DataTemplate DataType="vmc:PageContainerViewModel" x:DataType="vmc:PageContainerViewModel">
          <s:StudioLayerRow Glyph="M3,0H5V3H11V0H13V3H16V5H13V11H16V13H13V16H11V13H5V16H3V13H0V11H3V5H0V3H3Z M5,5V11H11V5Z" ContextMenu="{StaticResource PageContainerContextMenu}" />
        </DataTemplate>
        <DataTemplate DataType="vmc:LayerContainerViewModel" x:DataType="vmc:LayerContainerViewModel">
          <s:StudioLayerRow Glyph="M8,1L16,5L8,9L0,5Z M2,9L8,12L14,9L16,10L8,14L0,10Z" ContextMenu="{StaticResource LayerContainerContextMenu}" />
        </DataTemplate>
        <DataTemplate DataType="vms:BaseShapeViewModel" x:DataType="vms:BaseShapeViewModel">
          <s:StudioLayerRow Icon="{Binding Converter={x:Static converters:BaseShapeIconConverter.Instance}}" ContextMenu="{StaticResource BaseShapeContextMenu}" />
        </DataTemplate>
      </DataGrid.DataTemplates>
    </DataGrid>
  </DockPanel>
</UserControl>
