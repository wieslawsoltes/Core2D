<UserControl x:Class="Core2D.Views.Style.ArgbColorView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Style"
             xmlns:converters="using:Core2D.Converters" x:DataType="vm:ArgbColorViewModel" x:CompileBindings="True">
  <s:StudioColorField Color="{Binding Value, Mode=TwoWay, Converter={x:Static converters:UInt32ToColorConverter.Instance}}"
                      AutomationProperties.Name="Color" />
</UserControl>
