<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Editors"
  xmlns:data="using:Core2D.ViewModels.Data" xmlns:local="using:Core2D.Views.Editors"
  x:Class="Core2D.Views.Editors.TextBindingEditorView" x:DataType="vm:TextBindingEditorViewModel"
  x:CompileBindings="True" MinWidth="360" MinHeight="380">
  <Grid RowDefinitions="Auto,*,150" Background="{DynamicResource StudioSurfaceBrush}">
    <s:StudioPanelHeader Title="Text binding" Description="Insert data tokens or edit the expression below.">
      <Button Content="Reset" Command="{Binding OnResetText}" AutomationProperties.Name="Reset text binding"/>
    </s:StudioPanelHeader>
    <TabControl Grid.Row="1">
      <TabItem Header="Columns">
        <Grid RowDefinitions="Auto,*">
          <ComboBox Name="DatabasesComboBox" ItemsSource="{Binding Editor.Project.Databases}"
            SelectedItem="{Binding Editor.Project.CurrentDatabase, Mode=OneWay}" HorizontalAlignment="Stretch"
            Margin="10,8">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="data:DatabaseViewModel">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <s:StudioAssetBrowser Grid.Row="1"
            Items="{Binding #DatabasesComboBox.((data:DatabaseViewModel)SelectedItem).Columns}"
            IsCompact="True" EmptyTitle="No columns"
            EmptyDescription="Add data to the document to insert its tokens."
            OpenCommand="{Binding OnUseColumnName}">
            <s:StudioAssetBrowser.ItemTemplate>
              <DataTemplate x:DataType="data:ColumnViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="10,2" ColumnSpacing="8">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Insert" AutomationProperties.Name="Insert columns token"
                    Command="{Binding $parent[local:TextBindingEditorView].((vm:TextBindingEditorViewModel)DataContext).OnUseColumnName}"
                    CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </s:StudioAssetBrowser.ItemTemplate>
          </s:StudioAssetBrowser>
        </Grid>
      </TabItem>
      <TabItem Header="Page properties">
        <Grid RowDefinitions="Auto,*">
          <s:StudioAssetBrowser Grid.Row="1" Items="{Binding Editor.Project.CurrentContainer.Properties}"
            IsCompact="True" EmptyTitle="No page properties"
            EmptyDescription="Add data to the document to insert its tokens."
            OpenCommand="{Binding OnUsePageProperty}">
            <s:StudioAssetBrowser.ItemTemplate>
              <DataTemplate x:DataType="data:PropertyViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="10,2" ColumnSpacing="8">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Value}" Classes="studio-muted" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Insert" AutomationProperties.Name="Insert page properties token"
                    Command="{Binding $parent[local:TextBindingEditorView].((vm:TextBindingEditorViewModel)DataContext).OnUsePageProperty}"
                    CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </s:StudioAssetBrowser.ItemTemplate>
          </s:StudioAssetBrowser>
        </Grid>
      </TabItem>
      <TabItem Header="Shape properties">
        <Grid RowDefinitions="Auto,*">
          <s:StudioAssetBrowser Grid.Row="1" Items="{Binding Text.Properties}" IsCompact="True"
            EmptyTitle="No shape properties" EmptyDescription="Add data to the document to insert its tokens."
            OpenCommand="{Binding OnUseShapeProperty}">
            <s:StudioAssetBrowser.ItemTemplate>
              <DataTemplate x:DataType="data:PropertyViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="10,2" ColumnSpacing="8">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Value}" Classes="studio-muted" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Insert" AutomationProperties.Name="Insert shape properties token"
                    Command="{Binding $parent[local:TextBindingEditorView].((vm:TextBindingEditorViewModel)DataContext).OnUseShapeProperty}"
                    CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </s:StudioAssetBrowser.ItemTemplate>
          </s:StudioAssetBrowser>
        </Grid>
      </TabItem>
    </TabControl>
    <s:StudioCodeEditor Grid.Row="2" Text="{Binding Text.Text, Mode=TwoWay}" LanguageExtension=".txt" WordWrap="True"/>
  </Grid>
</UserControl>
