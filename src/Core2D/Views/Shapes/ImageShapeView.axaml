<UserControl x:Class="Core2D.Views.Shapes.ImageShapeView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Shapes"

             x:DataType="vm:ImageShapeViewModel" x:CompileBindings="True">
  <StackPanel Spacing="12">
    <s:StudioNameField Value="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="Image name" />
    <s:StudioBoundsEditor Start="{Binding TopLeft}" End="{Binding BottomRight}" />
    <s:StudioSection Header="Image source">
      <s:StudioPropertyField Label="Project image key">
        <s:StudioDataValueField Value="{Binding Key, Mode=TwoWay}" AutomationProperties.Name="Image key" Watermark="Image identifier" />
      </s:StudioPropertyField>
    </s:StudioSection>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <s:StudioSwitch Content="Fill" IsChecked="{Binding IsFilled, Mode=TwoWay}" />
      <s:StudioSwitch Grid.Column="1" Content="Stroke" IsChecked="{Binding IsStroked, Mode=TwoWay}" />
    </Grid>
  </StackPanel>
</UserControl>
