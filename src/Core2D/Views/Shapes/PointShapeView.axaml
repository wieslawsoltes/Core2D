<UserControl x:Class="Core2D.Views.Shapes.PointShapeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio"
             xmlns:vm="using:Core2D.ViewModels.Shapes"
             x:DataType="vm:PointShapeViewModel" x:CompileBindings="True">
  <Grid ColumnDefinitions="*,6,*" Margin="{DynamicResource ContentMargin}">
    <s:StudioPropertyField Label="X">
      <TextBox Text="{Binding X, Mode=TwoWay}" AutomationProperties.Name="X coordinate" />
    </s:StudioPropertyField>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Width="6" />
    <s:StudioPropertyField Grid.Column="2" Label="Y">
      <TextBox Text="{Binding Y, Mode=TwoWay}" AutomationProperties.Name="Y coordinate" />
    </s:StudioPropertyField>
  </Grid>
</UserControl>
