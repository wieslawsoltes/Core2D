<UserControl x:Class="Core2D.Views.Shapes.BlockShapeView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Shapes"

             x:DataType="vm:BlockShapeViewModel" x:CompileBindings="True">
  <StackPanel>
    <s:StudioSection Header="Block">
      <s:StudioNameField Value="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="Block name" />
    </s:StudioSection>
    <s:StudioSection Header="Object properties" IsExpanded="False">
      <s:StudioDataTable Source="{Binding}" IncludeChildProperties="True" Height="280" />
    </s:StudioSection>
    <s:StudioCollectionInspector Title="Block objects" Items="{Binding Shapes}" />
    <s:StudioSection Header="Connectors" IsExpanded="False">
      <s:StudioCollectionInspector Title="Connection points" Items="{Binding Connectors}" BrowserHeight="180" />
    </s:StudioSection>
  </StackPanel>
</UserControl>
