<UserControl x:Class="Core2D.Views.Shapes.ArcShapeView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Shapes"

             x:DataType="vm:ArcShapeViewModel" x:CompileBindings="True">
  <StackPanel Spacing="10">
    <s:StudioNameField Value="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="Object name" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <s:StudioSwitch Content="Fill" IsChecked="{Binding IsFilled, Mode=TwoWay}" />
      <s:StudioSwitch Grid.Column="1" Content="Stroke" IsChecked="{Binding IsStroked, Mode=TwoWay}" />
    </Grid>
    <s:StudioSection Header="Geometry">
      <StackPanel Spacing="4">
        <s:StudioPropertyField Label="Point 1"><s:StudioCoordinateEditor Source="{Binding Point1}" /></s:StudioPropertyField>
        <s:StudioPropertyField Label="Point 2"><s:StudioCoordinateEditor Source="{Binding Point2}" /></s:StudioPropertyField>
        <s:StudioPropertyField Label="Point 3"><s:StudioCoordinateEditor Source="{Binding Point3}" /></s:StudioPropertyField>
        <s:StudioPropertyField Label="Point 4"><s:StudioCoordinateEditor Source="{Binding Point4}" /></s:StudioPropertyField>
      </StackPanel>
    </s:StudioSection>
  </StackPanel>
</UserControl>
