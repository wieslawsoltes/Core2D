<UserControl x:Class="Core2D.Views.Shapes.TextShapeView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Shapes"
             x:DataType="vm:TextShapeViewModel" x:CompileBindings="True">
  <StackPanel Spacing="12">
    <TextBox Text="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="Text layer name" />
    <s:StudioBoundsEditor Start="{Binding TopLeft}" End="{Binding BottomRight}" />
    <s:StudioPropertyField Label="Text content" Margin="0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160" AutomationProperties.Name="Text content" />
        <s:StudioIconButton Grid.Column="1" Command="{Binding EditTextBinding}" CommandParameter="{Binding}" ToolTip.Tip="Edit text data binding"
                            AutomationProperties.Name="Edit text data binding" VerticalAlignment="Top" Icon="M5,2 H11 V4 H5 Z M2,5 H4 V11 H2 Z M12,5 H14 V11 H12 Z M5,12 H11 V14 H5 Z" />
      </Grid>
    </s:StudioPropertyField>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <s:StudioSwitch Content="Fill" IsChecked="{Binding IsFilled, Mode=TwoWay}" />
      <s:StudioSwitch Grid.Column="1" Content="Stroke" IsChecked="{Binding IsStroked, Mode=TwoWay}" />
    </Grid>
  </StackPanel>
</UserControl>
