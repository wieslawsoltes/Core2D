<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Editor"
  x:Class="Core2D.Views.Editor.AboutInfoView" x:DataType="vm:AboutInfoViewModel" x:CompileBindings="True">
  <StackPanel Spacing="16" Margin="20" MaxWidth="580">
    <s:StudioPanelHeader Title="{Binding Title}" Description="{Binding Description}"/>
    <s:StudioPropertyRow Label="Version">
      <SelectableTextBlock Text="{Binding Version}"/>
    </s:StudioPropertyRow>
    <s:StudioPropertyRow Label="Copyright">
      <SelectableTextBlock Text="{Binding Copyright}" TextWrapping="Wrap"/>
    </s:StudioPropertyRow>
    <s:StudioPropertyRow Label="License">
      <SelectableTextBlock Text="{Binding License}" TextWrapping="Wrap"/>
    </s:StudioPropertyRow>
    <s:StudioStatusBadge Content="Native Avalonia workspace" HorizontalAlignment="Left"/>
  </StackPanel>
</UserControl>
