<UserControl x:Class="Core2D.Views.Path.PathSizeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:studio="using:Core2D.Controls.Studio"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vmp="using:Core2D.ViewModels.Path"
             xmlns:vmd="using:Core2D.ViewModels.Designer"
             mc:Ignorable="d"
             d:DataContext="{x:Static vmd:DesignerContext.PathSize}"
             d:DesignWidth="250" d:DesignHeight="400"
             x:DataType="vmp:PathSizeViewModel" x:CompileBindings="True">
  <StackPanel Margin="{DynamicResource ContentMargin}">
    <studio:StudioPropertyField Label="Width">
      <studio:StudioNumberBox Prefix="W" Text="{Binding Width, Mode=TwoWay}" />
    </studio:StudioPropertyField>
    <studio:StudioPropertyField Label="Height">
      <studio:StudioNumberBox Prefix="H" Text="{Binding Height, Mode=TwoWay}" />
    </studio:StudioPropertyField>
  </StackPanel>
</UserControl>
