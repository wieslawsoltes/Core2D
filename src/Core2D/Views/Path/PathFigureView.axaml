<UserControl x:Class="Core2D.Views.Path.PathFigureView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Path"

             x:DataType="vm:PathFigureViewModel" x:CompileBindings="True">
  <StackPanel>
    <s:StudioSection Header="Figure">
      <StackPanel Spacing="8">
        <s:StudioNameField Value="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="Figure name" />
        <s:StudioSwitch Content="Closed path" IsChecked="{Binding IsClosed, Mode=TwoWay}" />
        <s:StudioPropertyField Label="Start point">
          <s:StudioCoordinateEditor Source="{Binding StartPoint}" />
        </s:StudioPropertyField>
      </StackPanel>
    </s:StudioSection>
    <s:StudioCollectionInspector Title="Path segments" Items="{Binding Segments}" BrowserHeight="200" />
  </StackPanel>
</UserControl>
