<UserControl x:Class="Core2D.Views.Path.Segments.LineSegmentView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Path.Segments"

             x:DataType="vm:LineSegmentViewModel" x:CompileBindings="True">
  <StackPanel Spacing="8">
    <s:StudioPropertyField Label="End"><s:StudioCoordinateEditor Source="{Binding Point}" /></s:StudioPropertyField>
  </StackPanel>
</UserControl>
