<UserControl x:Class="Core2D.Views.Path.Segments.QuadraticBezierSegmentView"
             xmlns="https://github.com/avaloniaui"
             xmlns:studio="using:Core2D.Controls.Studio"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vmps="using:Core2D.ViewModels.Path.Segments"
             xmlns:vmd="using:Core2D.ViewModels.Designer"
             mc:Ignorable="d"
             d:DataContext="{x:Static vmd:DesignerContext.QuadraticBezierSegment}"
             d:DesignWidth="250" d:DesignHeight="400"
             x:DataType="vmps:QuadraticBezierSegmentViewModel" x:CompileBindings="True">
  <StackPanel>
    <studio:StudioSection Header="Point1">
      <ContentControl Content="{Binding Point1}" />
    </studio:StudioSection>
    <studio:StudioSection Header="Point2">
      <ContentControl Content="{Binding Point2}" />
    </studio:StudioSection>
  </StackPanel>
</UserControl>
