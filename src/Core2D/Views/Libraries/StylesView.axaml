<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:app="using:Core2D"
  xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:idd="using:Avalonia.Xaml.Interactions.DragAndDrop"
  xmlns:dd="using:Core2D.Behaviors.DragAndDrop" xmlns:vmc="using:Core2D.ViewModels.Containers"
  xmlns:vms="using:Core2D.ViewModels.Style" xmlns:vmd="using:Core2D.ViewModels.Designer"
  xmlns:c="clr-namespace:Core2D.Controls" xmlns:s="using:Core2D.Controls.Studio" xmlns:behaviors="using:Core2D.Behaviors"
  x:Class="Core2D.Views.Libraries.StylesView" mc:Ignorable="d" d:DataContext="{x:Static vmd:DesignerContext.Project}"
  d:DesignWidth="250" d:DesignHeight="400" x:DataType="vmc:ProjectContainerViewModel" x:CompileBindings="True">
  <UserControl.Resources>
    <dd:StudioLibraryDropHandler x:Key="StudioLibraryDrop"/>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource StudioSurfaceBrush}" s:StudioEditContext.History="{Binding History}">
    <s:StudioPanelHeader Title="Styles" Description="Manage reusable appearance settings"/>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Grid.Row="1">
      <Grid RowDefinitions="*" ColumnDefinitions="*,Auto" Margin="{DynamicResource ContentMargin}" Grid.Row="0">
        <TextBox Text="{Binding CurrentStyleLibrary.Name, Mode=TwoWay, FallbackValue={x:Null}}" BorderBrush="Transparent"
          Background="Transparent" VerticalAlignment="Center" Margin="0,0,0,0"
          IsVisible="{Binding !!CurrentStyleLibrary}" Grid.Column="0" />
        <s:StudioToolbar Grid.Column="1">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
            <Button Content="Remove" Command="{Binding RemoveStyleLibrary}"
              CommandParameter="{Binding CurrentStyleLibrary}" IsVisible="{Binding !!CurrentStyleLibrary}"
              BorderBrush="Transparent" Background="Transparent" Padding="8,5"
              AutomationProperties.Name="RemoveStyleLibrary" />
            <Button Content="Add" Command="{Binding AddStyleLibrary}" BorderBrush="Transparent" Background="Transparent"
              Padding="8,5" AutomationProperties.Name="AddStyleLibrary" />
          </StackPanel>
        </s:StudioToolbar>
      </Grid>
      <ComboBox ItemsSource="{Binding StyleLibraries}" SelectedItem="{Binding CurrentStyleLibrary, Mode=TwoWay}"
        IsVisible="{Binding !!CurrentStyleLibrary}" HorizontalAlignment="Stretch"
        Margin="{DynamicResource ContentMargin}" Grid.Row="1">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vmc:LibraryViewModel">
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <s:StudioToolbar Grid.Row="2">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding !!CurrentStyleLibrary}" Spacing="2">
          <Button Content="Apply" Command="{Binding ApplyStyle}"
            CommandParameter="{Binding CurrentStyleLibrary.Selected, FallbackValue={x:Null}}"
            IsVisible="{Binding !!CurrentStyleLibrary.Selected}" BorderBrush="Transparent"
            Background="Transparent" Padding="8,5" AutomationProperties.Name="ApplyStyle" />
          <Button Content="Remove" Command="{Binding RemoveStyle}"
            CommandParameter="{Binding CurrentStyleLibrary.Selected, FallbackValue={x:Null}}"
            IsVisible="{Binding !!CurrentStyleLibrary.Selected}" BorderBrush="Transparent"
            Background="Transparent" Padding="8,5" AutomationProperties.Name="RemoveStyle" />
          <Button Content="Add" Command="{Binding AddStyle}" BorderBrush="Transparent" Background="Transparent"
            Padding="8,5" AutomationProperties.Name="AddStyle" />
        </StackPanel>
      </s:StudioToolbar>
      <s:StudioAssetBrowser x:Name="StylesListBox" Items="{Binding CurrentStyleLibrary.Items}"
        SelectedItem="{Binding CurrentStyleLibrary.Selected, Mode=TwoWay}" EmptyTitle="No styles found"
        EmptyDescription="Try a different search or add an item from the toolbar." Grid.Row="3">
        <s:StudioAssetBrowser.KeyBindings>
          <KeyBinding Command="{Binding AddStyle}" Gesture="{app:PlatformGesture Text=Primary+N}"/>
          <KeyBinding Command="{Binding RemoveStyle}"
            CommandParameter="{Binding CurrentStyleLibrary.Selected, FallbackValue={x:Null}}" Gesture="Delete" />
          <KeyBinding Command="{Binding ExportStyle}"
            CommandParameter="{Binding CurrentStyleLibrary.Selected, FallbackValue={x:Null}}"
            Gesture="{app:PlatformGesture Text=Primary+E}" />
        </s:StudioAssetBrowser.KeyBindings>
        <s:StudioAssetBrowser.Resources>
          <ContextMenu x:Key="ShapeStyleContextMenu" x:DataType="vms:ShapeStyleViewModel">
            <MenuItem Header="_Delete" Command="{Binding RemoveStyle}" CommandParameter="{Binding Mode=OneWay}"/>
            <Separator/>
            <MenuItem Header="E_xport" Command="{Binding ExportStyle}" CommandParameter="{Binding Mode=OneWay}"/>
          </ContextMenu>
        </s:StudioAssetBrowser.Resources>
        <i:Interaction.Behaviors>
          <behaviors:StudioScopedKeyBindingsBehavior/>
          <idd:ContextDropBehavior Context="{Binding CurrentStyleLibrary}" Handler="{StaticResource StudioLibraryDrop}"/>
        </i:Interaction.Behaviors>
        <s:StudioAssetBrowser.ItemTemplate>
          <DataTemplate x:DataType="vms:ShapeStyleViewModel">
            <s:StudioAssetItem Title="{Binding Name, Mode=TwoWay}" Detail="Fill, stroke and typography"
              Icon="M2,2 H14 V14 H2 Z M5,5 H11 V11 H5 Z"
              IsCompact="{Binding $parent[s:StudioAssetBrowser].IsCompact}"
              ContextMenu="{StaticResource ShapeStyleContextMenu}">
              <i:Interaction.Behaviors>
                <idd:ContextDragBehavior Context="{Binding}"/>
              </i:Interaction.Behaviors>
            </s:StudioAssetItem>
          </DataTemplate>
        </s:StudioAssetBrowser.ItemTemplate>
      </s:StudioAssetBrowser>
    </Grid>
  </Grid>
</UserControl>
