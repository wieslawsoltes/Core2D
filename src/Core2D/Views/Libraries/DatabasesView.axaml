<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:vmdt="using:Core2D.ViewModels.Data"
  xmlns:vmc="using:Core2D.ViewModels.Containers" xmlns:vmd="using:Core2D.ViewModels.Designer"
  xmlns:s="using:Core2D.Controls.Studio" x:Class="Core2D.Views.Libraries.DatabasesView" mc:Ignorable="d"
  d:DataContext="{x:Static vmd:DesignerContext.Project}" d:DesignWidth="250" d:DesignHeight="400"
  x:DataType="vmc:ProjectContainerViewModel" x:CompileBindings="True">
  <Grid s:StudioEditContext.History="{Binding History}" RowDefinitions="Auto,*" Background="{DynamicResource StudioSurfaceBrush}">
    <s:StudioPanelHeader Title="Data sources" Description="Records and columns attached to this project"/>
    <Grid RowDefinitions="Auto,Auto,*" Grid.Row="1">
      <Grid RowDefinitions="*" ColumnDefinitions="*,Auto" Margin="{DynamicResource ContentMargin}" Grid.Row="0">
        <s:StudioNameField DataContext="{Binding CurrentDatabase}" x:DataType="vmdt:DatabaseViewModel" Value="{Binding Name, Mode=TwoWay}" BorderBrush="Transparent"
          Background="Transparent" VerticalAlignment="Center" Margin="0,0,0,0"
          IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" Grid.Column="0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="Remove" Command="{Binding RemoveDatabase}" CommandParameter="{Binding CurrentDatabase}"
            IsVisible="{Binding !!CurrentDatabase}" BorderBrush="Transparent" Background="Transparent"
            Padding="8,5" />
          <Button Content="Add" Command="{Binding AddDatabase}" BorderBrush="Transparent" Background="Transparent" Padding="8,5"/>
        </StackPanel>
      </Grid>
      <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding CurrentDatabase, Mode=TwoWay}"
        IsVisible="{Binding !!CurrentDatabase}" HorizontalAlignment="Stretch"
        Margin="{DynamicResource ContentMargin}" Grid.Row="1">
        <ComboBox.DataTemplates>
          <DataTemplate DataType="vmdt:DatabaseViewModel" x:DataType="vmdt:DatabaseViewModel">
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.DataTemplates>
      </ComboBox>
      <Grid Grid.Row="2">
        <ContentControl Content="{Binding CurrentDatabase}" />
        <s:StudioEmptyState Title="No data source selected" Description="Create a database to organize reusable records and columns, then apply records to drawing objects."
                            IsVisible="{Binding !CurrentDatabase}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
