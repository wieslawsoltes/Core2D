<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:s="using:Core2D.Controls.Studio" xmlns:i="using:Avalonia.Xaml.Interactivity"
  xmlns:idd="using:Avalonia.Xaml.Interactions.DragAndDrop" xmlns:vm="using:Core2D.ViewModels.Containers"
  xmlns:r="using:Core2D.ViewModels.Renderer" x:Class="Core2D.Views.Libraries.ImagesView"
  x:DataType="vm:ProjectContainerViewModel" x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource StudioSurfaceBrush}">
    <s:StudioPanelHeader Title="Images" Description="Image resources in this project">
      <Button Content="Add" Command="{Binding AddImageKey}" AutomationProperties.Name="Add image"/>
    </s:StudioPanelHeader>
    <s:StudioAssetBrowser Grid.Row="1" Items="{Binding Keys}" EmptyTitle="No images found"
      EmptyDescription="Add an image resource or change your search.">
      <s:StudioAssetBrowser.ItemTemplate>
        <DataTemplate x:DataType="r:ImageKeyViewModel">
          <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8" Margin="8,4">
            <i:Interaction.Behaviors>
              <idd:ContextDragBehavior Context="{Binding}"/>
            </i:Interaction.Behaviors>
            <PathIcon Data="M1,1 H15 V15 H1 Z M3,3 V13 H13 V3 Z M4,11 L7,6 L9,9 L11,7 L13,12 H4 Z" Width="18" Height="18"
              Foreground="{DynamicResource StudioMutedBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding Key}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Key}"
              VerticalAlignment="Center" />
            <s:StudioIconButton Grid.Column="2"
              Icon="M3,2 L8,7 L13,2 L14,3 L9,8 L14,13 L13,14 L8,9 L3,14 L2,13 L7,8 L2,3 Z"
              Command="{Binding RemoveImageKey}" CommandParameter="{Binding Key}" ToolTip.Tip="Remove image"
              AutomationProperties.Name="Remove image" />
          </Grid>
        </DataTemplate>
      </s:StudioAssetBrowser.ItemTemplate>
    </s:StudioAssetBrowser>
  </Grid>
</UserControl>
