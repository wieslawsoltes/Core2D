<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:s="using:Core2D.Controls.Studio" xmlns:app="using:Core2D" xmlns:vm="using:Core2D.ViewModels.Scripting"
  x:Class="Core2D.Views.Scripting.ScriptView" x:DataType="vm:ScriptViewModel" x:CompileBindings="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="{app:PlatformGesture Text=Primary+Enter}" Command="{Binding ExecuteRepl}"
      CommandParameter="{Binding Code}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,*" MinHeight="180">
    <s:StudioPanelHeader Title="{Binding Name}" Description="C# · Ctrl/Command+Enter runs in the REPL">
      <Button Content="Run" Command="{Binding ExecuteCode}" CommandParameter="{Binding Code}" Classes="studio-primary"
        AutomationProperties.Name="Run script" />
    </s:StudioPanelHeader>
    <s:StudioCodeEditor Name="ScriptTextEditor" Grid.Row="1" Text="{Binding Code, Mode=TwoWay}"/>
  </Grid>
</UserControl>
