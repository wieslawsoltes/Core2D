<UserControl x:Class="Core2D.Views.Renderer.ShapeRendererStateView"
             xmlns="https://github.com/avaloniaui"
             xmlns:studio="using:Core2D.Controls.Studio"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mr="using:Core2D.Model.Renderer"
             xmlns:vmr="using:Core2D.ViewModels.Renderer"
             xmlns:vmd="using:Core2D.ViewModels.Designer"
             mc:Ignorable="d"
             d:DataContext="{x:Static vmd:DesignerContext.ShapeRendererState}"
             d:DesignWidth="250" d:DesignHeight="400"
             x:DataType="vmr:ShapeRendererStateViewModel" x:CompileBindings="True">
  <studio:StudioSettingsPanel>
    <studio:StudioSettingsSection Header="Point" Keywords="points handles size decorators vertices">
      <StackPanel Margin="0">
        <studio:StudioSettingToggle Content="Selection decorators" Description="Show the existing manipulation and selection adorners."
                  IsChecked="{Binding DrawDecorators, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" />
        <studio:StudioSettingToggle Content="Control points" Description="Show editable points and connection handles."
                  IsChecked="{Binding DrawPoints, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" />
        <studio:StudioPropertyField Label="Point Size">
          <studio:StudioNumericField Prefix="#" Minimum="0" Maximum="1000000" Value="{Binding PointSize, Mode=TwoWay}" AutomationProperties.Name="Control point size" />
        </studio:StudioPropertyField>
      </StackPanel>
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Normal Style" Keywords="points fill stroke normal" IsExpanded="False">
      <ContentControl Content="{Binding PointStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Selected Style" Keywords="points active selected fill stroke" IsExpanded="False">
      <ContentControl Content="{Binding SelectedPointStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Connector Default" Keywords="connection none default" IsExpanded="False">
      <ContentControl Content="{Binding ConnectorNoneStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Connector Input" Keywords="connection input port" IsExpanded="False">
      <ContentControl Content="{Binding ConnectorInputStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Connector Output" Keywords="connection output port" IsExpanded="False">
      <ContentControl Content="{Binding ConnectorOutputStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Connector Hover" Keywords="connection mouse hover" IsExpanded="False">
      <ContentControl Content="{Binding ConnectorHoverStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Connector Tool Hover" Keywords="connection tool mouse hover valid" IsExpanded="False">
      <ContentControl Content="{Binding ConnectorToolHoverStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Connector Tool Hover Invalid" Keywords="connection tool mouse hover invalid" IsExpanded="False">
      <ContentControl Content="{Binding ConnectorToolHoverInvalidStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Connector Selected" Keywords="connection active selected" IsExpanded="False">
      <ContentControl Content="{Binding ConnectorSelectedStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Zoom" Keywords="viewport pan offset zoom transform scale" IsExpanded="False">
      <StackPanel Margin="0">
        <studio:StudioPropertyField Label="Pan X">
          <studio:StudioNumberBox Prefix="X" Text="{Binding PanX, Mode=TwoWay}" AutomationProperties.Name="PanX" />
        </studio:StudioPropertyField>
        <studio:StudioPropertyField Label="Pan Y">
          <studio:StudioNumberBox Prefix="Y" Text="{Binding PanY, Mode=TwoWay}" AutomationProperties.Name="PanY" />
        </studio:StudioPropertyField>
        <studio:StudioPropertyField Label="Zoom X">
          <studio:StudioNumberBox Prefix="X" Text="{Binding ZoomX, Mode=TwoWay}" AutomationProperties.Name="ZoomX" />
        </studio:StudioPropertyField>
        <studio:StudioPropertyField Label="Zoom Y">
          <studio:StudioNumberBox Prefix="Y" Text="{Binding ZoomY, Mode=TwoWay}" AutomationProperties.Name="ZoomY" />
        </studio:StudioPropertyField>
      </StackPanel>
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Draw Shape State" Keywords="visible printable locked thickness size state" IsExpanded="False">
      <StackPanel Spacing="8">
        <studio:StudioReadout Label="Renderer state mask" Value="{Binding DrawShapeState}" />
        <studio:StudioNotice Message="This is the renderer's active draw mask. Edit individual objects in the inspector's State tab." />
      </StackPanel>
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Image Cache" Keywords="images resources cache" IsExpanded="False">
      <Panel DataContext="{Binding ImageCache}">
        <studio:StudioAssetBrowser x:DataType="mr:IImageCache" Items="{Binding Keys}" IsCompact="True" Height="220"
                                  EmptyTitle="No cached images" EmptyDescription="Images appear when the renderer loads them." />
      </Panel>
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Selection Style" Keywords="selection outline fill stroke" IsExpanded="False">
      <ContentControl Content="{Binding SelectionStyle}" />
    </studio:StudioSettingsSection>
    <studio:StudioSettingsSection Header="Helper Style" Keywords="helper guide style fill stroke" IsExpanded="False">
      <ContentControl Content="{Binding HelperStyle}" />
    </studio:StudioSettingsSection>
  </studio:StudioSettingsPanel>
</UserControl>
