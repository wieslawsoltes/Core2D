<UserControl x:Class="Core2D.Controls.Studio.StudioArrowField"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio" xmlns:vm="using:Core2D.ViewModels.Style"
             x:DataType="vm:ArrowStyleViewModel" x:CompileBindings="True">
  <Grid ColumnDefinitions="40*,6,30*,6,30*">
    <ComboBox ItemsSource="{x:Static vm:StrokeStyleViewModel.ArrowTypeValues}" SelectedItem="{Binding ArrowType, Mode=TwoWay}"
              HorizontalAlignment="Stretch" AutomationProperties.Name="Arrow type" />
    <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
    <s:StudioNumberBox Grid.Column="2" Prefix="RX" Text="{Binding RadiusX, Mode=TwoWay}" AutomationProperties.Name="Arrow radius X" />
    <GridSplitter Grid.Column="3" Width="6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
    <s:StudioNumberBox Grid.Column="4" Prefix="RY" Text="{Binding RadiusY, Mode=TwoWay}" AutomationProperties.Name="Arrow radius Y" />
  </Grid>
</UserControl>
