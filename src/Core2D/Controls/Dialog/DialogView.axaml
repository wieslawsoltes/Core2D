<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:s="using:Core2D.Controls.Studio" xmlns:i="using:Avalonia.Xaml.Interactivity"
  xmlns:custom="using:Avalonia.Xaml.Interactions.Custom" xmlns:b="using:Core2D.Behaviors"
  xmlns:vm="using:Core2D.ViewModels.Editor" x:Class="Core2D.Controls.Dialog.DialogView" x:DataType="vm:DialogViewModel"
  x:CompileBindings="True">
  <i:Interaction.Behaviors>
    <b:StudioModalBehavior/>
  </i:Interaction.Behaviors>
  <Grid IsVisible="{Binding ViewModel, Converter={x:Static ObjectConverters.IsNotNull}}">
    <Button Name="DialogBackdrop" IsVisible="{Binding IsOverlayVisible}" Command="{Binding CloseCommand}"
      Background="{DynamicResource DialogOverlayColor}" BorderThickness="0" CornerRadius="0" Padding="0"
      Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
      AutomationProperties.Name="Dismiss dialog">
      <Button.Template>
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"/>
        </ControlTemplate>
      </Button.Template>
    </Button>
    <Border Name="DragBorder" Margin="16" Background="{DynamicResource StudioSurfaceBrush}"
      BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1" CornerRadius="12"
      BoxShadow="{DynamicResource StudioElevation}" HorizontalAlignment="Center" VerticalAlignment="Center"
      KeyboardNavigation.TabNavigation="Cycle">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Name="TitleBorder" IsVisible="{Binding IsTitleBarVisible}" Padding="16,12"
          BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1">
          <i:Interaction.Behaviors>
            <custom:DragControlBehavior TargetControl="{Binding #DragBorder}"/>
          </i:Interaction.Behaviors>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="12">
          <ContentControl Name="DialogContent" Content="{Binding ViewModel}"/>
        </ScrollViewer>
        <Border Grid.Row="2" IsVisible="{Binding IsCloseButtonVisible}" Padding="16,10"
          BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,1,0,0">
          <Button Name="CloseButton" Content="Done" Command="{Binding CloseCommand}" HorizontalAlignment="Right"
            MinWidth="80" Classes="studio-primary" AutomationProperties.Name="Close dialog" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
