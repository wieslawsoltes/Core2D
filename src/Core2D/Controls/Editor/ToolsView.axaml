<UserControl x:Class="Core2D.Controls.Editor.ToolsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Core2D.Controls.Studio"
             xmlns:converters="using:Core2D.Converters"
             xmlns:vm="using:Core2D.ViewModels.Editor"
             x:DataType="vm:ProjectEditorViewModel" x:CompileBindings="True">
  <s:StudioToolShelf AutomationProperties.Name="Drawing tools">
    <StackPanel Orientation="Horizontal" Spacing="2">
      <!-- Unnamed radio groups are local to their parent: split document panes stay independent. -->
      <s:StudioToolButton Icon="{DynamicResource Selection}" Command="{Binding OnToolSelection}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Selection}"
                          ToolTip.Tip="Selection tool" AutomationProperties.Name="Selection tool" />
      <Separator Classes="studio-tool-separator" />
      <s:StudioToolButton Icon="{DynamicResource Point}" Command="{Binding OnToolPoint}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Point}"
                          ToolTip.Tip="Point tool" AutomationProperties.Name="Point tool" />
      <s:StudioToolButton Icon="{DynamicResource Line}" Command="{Binding OnToolLine}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Line}"
                          ToolTip.Tip="Line tool" AutomationProperties.Name="Line tool" />
      <s:StudioToolButton Icon="{DynamicResource Arc}" Command="{Binding OnToolArc}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Arc}"
                          ToolTip.Tip="Arc tool" AutomationProperties.Name="Arc tool" />
      <s:StudioToolButton Icon="{DynamicResource CubicBezier}" Command="{Binding OnToolCubicBezier}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=CubicBezier}"
                          ToolTip.Tip="Cubic Bezier tool" AutomationProperties.Name="Cubic Bezier tool" />
      <s:StudioToolButton Icon="{DynamicResource QuadraticBezier}" Command="{Binding OnToolQuadraticBezier}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=QuadraticBezier}"
                          ToolTip.Tip="Quadratic Bezier tool" AutomationProperties.Name="Quadratic Bezier tool" />
      <s:StudioToolButton Icon="{DynamicResource Path}" Command="{Binding OnToolPath}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Path}"
                          ToolTip.Tip="Path tool" AutomationProperties.Name="Path tool" />
      <Separator Classes="studio-tool-separator" />
      <s:StudioToolButton Icon="{DynamicResource Rectangle}" Command="{Binding OnToolRectangle}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Rectangle}"
                          ToolTip.Tip="Rectangle tool" AutomationProperties.Name="Rectangle tool" />
      <s:StudioToolButton Icon="{DynamicResource Ellipse}" Command="{Binding OnToolEllipse}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Ellipse}"
                          ToolTip.Tip="Ellipse tool" AutomationProperties.Name="Ellipse tool" />
      <s:StudioToolButton Icon="{DynamicResource Text}" Command="{Binding OnToolText}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Text}"
                          ToolTip.Tip="Text tool" AutomationProperties.Name="Text tool" />
      <s:StudioToolButton Icon="{DynamicResource Image}" Command="{Binding OnToolImage}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Image}"
                          ToolTip.Tip="Image tool" AutomationProperties.Name="Image tool" />
      <Separator Classes="studio-tool-separator" />
      <s:StudioToolButton Icon="{DynamicResource Wire}" Command="{Binding OnToolWire}"
                          IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Wire}"
                          ToolTip.Tip="Wire tool" AutomationProperties.Name="Wire tool" />
      <StackPanel Orientation="Horizontal" Spacing="2"
                  IsVisible="{Binding CurrentTool, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Path}">
        <Separator Classes="studio-tool-separator" />
        <s:StudioToolButton Icon="{DynamicResource Line}" Command="{Binding OnToolLine}"
                            IsChecked="{Binding CurrentPathTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Line}"
                            ToolTip.Tip="Path line" AutomationProperties.Name="Path line" />
        <s:StudioToolButton Icon="{DynamicResource Arc}" Command="{Binding OnToolArc}"
                            IsChecked="{Binding CurrentPathTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Arc}"
                            ToolTip.Tip="Path arc" AutomationProperties.Name="Path arc" />
        <s:StudioToolButton Icon="{DynamicResource CubicBezier}" Command="{Binding OnToolCubicBezier}"
                            IsChecked="{Binding CurrentPathTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=CubicBezier}"
                            ToolTip.Tip="Path cubic Bezier" AutomationProperties.Name="Path cubic Bezier" />
        <s:StudioToolButton Icon="{DynamicResource QuadraticBezier}" Command="{Binding OnToolQuadraticBezier}"
                            IsChecked="{Binding CurrentPathTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=QuadraticBezier}"
                            ToolTip.Tip="Path quadratic Bezier" AutomationProperties.Name="Path quadratic Bezier" />
        <s:StudioToolButton Icon="{DynamicResource Move}" Command="{Binding OnToolMove}"
                            IsChecked="{Binding CurrentPathTool, Mode=OneWay, Converter={x:Static converters:IsCurrentToolConverter.Instance}, ConverterParameter=Move}"
                            ToolTip.Tip="Path move" AutomationProperties.Name="Path move" />
      </StackPanel>
    </StackPanel>
  </s:StudioToolShelf>
</UserControl>
