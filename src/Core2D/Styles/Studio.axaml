<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ruler="clr-namespace:Core2D.Controls;assembly=Core2D.Controls.Ruler">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="avares://Core2D/Styles/StudioControls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Retain native input, validation and automation. Template text inherits its control foreground. -->
  <Style Selector=":is(TemplatedControl)">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.studio-muted">
    <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.studio-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.studio-primary">
    <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioOnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,7" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource StudioInputBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource StudioInputBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource StudioInputBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="Padding" Value="0,6,0,4" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource StudioBorderBrush}" />
  </Style>
  <Style Selector="Separator.studio-tool-separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="ListBoxItem TextBlock">
    <Setter Property="Padding" Value="4,3" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowHeight" Value="28" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource StudioInputBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="ruler|Ruler">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="TickBrush" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="TextBrush" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="AccentBrush" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="SelectionLabelBrush" Value="{DynamicResource StudioTextBrush}" />
  </Style>

  <!-- Dock owns drag, resize, float, close, pin and persistence. Match derived tab item controls too. -->
  <Style Selector="DockControl">
    <Setter Property="Background" Value="{DynamicResource StudioCanvasBrush}" />
  </Style>
  <Style Selector="ToolControl">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="ToolControl /template/ DockPanel#PART_DockPanel">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
  </Style>
  <Style Selector="ToolControl /template/ TabStrip#PART_TabStrip">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
  </Style>
  <Style Selector="ToolControl /template/ TabStrip#PART_TabStrip :is(TabStripItem)">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ToolControl /template/ TabStrip#PART_TabStrip :is(TabStripItem):selected">
    <Setter Property="Background" Value="{DynamicResource StudioSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioSelectionTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="DocumentControl">
    <Setter Property="Background" Value="{DynamicResource StudioCanvasBrush}" />
  </Style>
  <Style Selector="DocumentControl /template/ :is(TabStripItem)">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
  </Style>
  <Style Selector="DocumentControl /template/ :is(TabStripItem):selected">
    <Setter Property="Foreground" Value="{DynamicResource StudioOnAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
  </Style>
</Styles>
