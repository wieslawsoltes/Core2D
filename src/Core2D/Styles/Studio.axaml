<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dmc="using:Dock.Model.Controls"
        xmlns:converters="using:Core2D.Converters"
        xmlns:ruler="clr-namespace:Core2D.Controls;assembly=Core2D.Controls.Ruler">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Core2D/Styles/StudioControls.axaml" />
        <ResourceInclude Source="avares://Core2D/Styles/StudioInputs.axaml" />
        <ResourceInclude Source="avares://Core2D/Styles/StudioNavigation.axaml" />
        <ResourceInclude Source="avares://Core2D/Styles/StudioColorField.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:MultipleDockTabsConverter x:Key="MultipleDockTabs" />
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector=":is(TemplatedControl)">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.studio-muted">
    <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.studio-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Theme" Value="{StaticResource StudioButtonTheme}" />
  </Style>
  <Style Selector="Button.studio-primary">
    <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioOnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,7" />
  </Style>
  <Style Selector="Button.studio-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioOnAccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Theme" Value="{StaticResource StudioTextBoxTheme}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Theme" Value="{StaticResource StudioCheckBoxTheme}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Theme" Value="{StaticResource StudioComboBoxTheme}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource StudioInputBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="Padding" Value="0,6,0,4" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource StudioBorderBrush}" />
  </Style>
  <Style Selector="Separator.studio-tool-separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TabControl">
    <Setter Property="Theme" Value="{StaticResource StudioTabControlTheme}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Theme" Value="{StaticResource StudioTabItemTheme}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="ListBoxItem TextBlock">
    <Setter Property="Padding" Value="4,3" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowHeight" Value="28" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource StudioInputBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
  </Style>
  <Style Selector="ruler|Ruler">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="TickBrush" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="TextBrush" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="AccentBrush" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="SelectionLabelBrush" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="ruler|Ruler:horizontal"><Setter Property="Height" Value="24" /></Style>
  <Style Selector="ruler|Ruler:vertical"><Setter Property="Width" Value="24" /></Style>

  <!-- Keep Dock's drag targets, resize handles and floating windows; remove only redundant single-tab chrome. -->
  <Style Selector="DockControl">
    <Setter Property="Background" Value="{DynamicResource StudioCanvasBrush}" />
  </Style>
  <Style Selector="ToolControl">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="ToolControl /template/ DockPanel#PART_DockPanel">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
  </Style>
  <Style Selector="ToolControl /template/ :is(TabStrip)#PART_TabStrip" x:DataType="dmc:IToolDock" x:CompileBindings="True">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="DockPanel.Dock" Value="Top" />
    <Setter Property="IsVisible" Value="{Binding VisibleDockables.Count, Converter={StaticResource MultipleDockTabs}}" />
  </Style>
  <Style Selector="ToolControl /template/ :is(TabStrip)#PART_TabStrip :is(TabStripItem)">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ToolControl /template/ :is(TabStrip)#PART_TabStrip :is(TabStripItem):selected">
    <Setter Property="Background" Value="{DynamicResource StudioSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioSelectionTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="DocumentControl">
    <Setter Property="Background" Value="{DynamicResource StudioCanvasBrush}" />
  </Style>
  <Style Selector="DocumentControl /template/ :is(TabStripItem)">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="Background" Value="{DynamicResource StudioCanvasBrush}" />
  </Style>
  <Style Selector="DocumentControl /template/ :is(TabStripItem):selected">
    <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
</Styles>
