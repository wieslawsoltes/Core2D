<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Dock.Model.Core"
        xmlns:dmc="using:Dock.Model.Controls"
        xmlns:dc="using:Dock.Avalonia.Controls"
        xmlns:split="using:Dock.Controls.ProportionalStackPanel"
        xmlns:converters="using:Core2D.Converters" x:CompileBindings="True">
  <!-- Presentation-only bridge for Dock 11.3.11.5. No Template/Theme replacement, input behavior,
       drag target, content-recycling, close/pin policy, or layout persistence is changed here. -->
  <Styles.Resources>
    <converters:MultipleDockTabsConverter x:Key="StudioDockMultipleTabs" />
  </Styles.Resources>

  <Style Selector="dc|DockControl">
    <Setter Property="Background" Value="{DynamicResource DockSurfaceWorkbenchBrush}" />
  </Style>
  <Style Selector="dc|DocumentControl, dc|ToolControl">
    <Setter Property="Background" Value="{DynamicResource DockSurfacePanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DockThemeForegroundBrush}" />
  </Style>
  <Style Selector="dc|DocumentControl">
    <Setter Property="HeaderTemplate">
      <DataTemplate DataType="core:IDockable" x:DataType="core:IDockable">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="M3,1H9L13,5V15H3Z M4,2V14H12V6H8V2Z M9,2.4V5H11.6Z"
                    Width="14" Height="14" Foreground="{Binding $parent[TabStripItem].Foreground}" />
          <TextBlock Text="{Binding Title}" Foreground="{Binding $parent[TabStripItem].Foreground}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
        </StackPanel>
      </DataTemplate>
    </Setter>
  </Style>
  <Style Selector="dc|ToolControl">
    <Setter Property="HeaderTemplate">
      <DataTemplate DataType="core:IDockable" x:DataType="core:IDockable">
        <TextBlock Text="{Binding Title}" Foreground="{Binding $parent[TabStripItem].Foreground}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
      </DataTemplate>
    </Setter>
  </Style>

  <Style Selector="dc|ToolControl /template/ DockPanel#PART_DockPanel">
    <Setter Property="Background" Value="{DynamicResource DockSurfaceSidebarBrush}" />
  </Style>
  <Style Selector="dc|ToolControl /template/ dc|ToolTabStrip#PART_TabStrip" x:DataType="dmc:IToolDock">
    <Setter Property="IsVisible" Value="{Binding VisibleDockables.Count, Converter={StaticResource StudioDockMultipleTabs}}" />
  </Style>
  <Style Selector="dc|DocumentControl /template/ Border#PART_Border, dc|ToolControl /template/ Border#PART_Border">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource DockSurfaceEditorBrush}" />
  </Style>
  <Style Selector="dc|DocumentControl /template/ Grid#PART_Grid, dc|DocumentControl:active /template/ Grid#PART_Grid">
    <Setter Property="Background" Value="{DynamicResource DockSeparatorBrush}" />
  </Style>
  <Style Selector="dc|DocumentControl[TabsLayout=Top] /template/ Grid#PART_Grid">
    <Setter Property="Height" Value="1" />
  </Style>
  <Style Selector="dc|DocumentControl[TabsLayout=Left] /template/ Grid#PART_Grid, dc|DocumentControl[TabsLayout=Right] /template/ Grid#PART_Grid">
    <Setter Property="Width" Value="1" />
  </Style>

  <!-- Constant border thickness keeps tab content stationary when selection/focus changes. -->
  <Style Selector="dc|DocumentTabStripItem, dc|ToolTabStripItem">
    <Setter Property="MinHeight" Value="{DynamicResource DockTabItemMinHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource DockFontSizeNormal}" />
    <Setter Property="Background" Value="{DynamicResource DockTabBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DockTabForegroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="dc|DocumentTabStripItem">
    <Setter Property="Padding" Value="{DynamicResource DockDocumentTabItemPadding}" />
  </Style>
  <Style Selector="dc|ToolTabStripItem, dc|ToolTabStripItem:selected">
    <Setter Property="Padding" Value="{DynamicResource DockToolTabItemPadding}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="dc|DocumentTabStripItem /template/ Border, dc|ToolTabStripItem /template/ Border">
    <Setter Property="CornerRadius" Value="{DynamicResource DockDocumentTabItemCornerRadius}" />
  </Style>
  <Style Selector="dc|DocumentTabStripItem:pointerover, dc|ToolTabStripItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource DockTabHoverBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DockTabSelectedForegroundBrush}" />
  </Style>
  <Style Selector="dc|DocumentTabStripItem:selected, dc|DocumentTabStripItem:selected:pointerover, dc|ToolTabStripItem:selected, dc|ToolTabStripItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource DockTabActiveBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DockTabSelectedForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockBorderStrongBrush}" />
  </Style>
  <Style Selector="dc|DocumentTabStripItem:active:selected, dc|ToolChromeControl:active dc|ToolTabStripItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource DockTabActiveIndicatorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DockTabActiveForegroundBrush}" />
  </Style>
  <Style Selector="dc|DocumentTabStripItem:focus-visible, dc|ToolTabStripItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource DockTabActiveIndicatorBrush}" />
  </Style>
  <Style Selector="dc|DocumentTabStripItem:disabled, dc|ToolTabStripItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource BrowserDisabledBrush}" />
  </Style>
  <Style Selector="dc|DocumentControl[TabsLayout=Left] dc|DocumentTabStripItem">
    <Setter Property="BorderThickness" Value="0,0,2,0" />
  </Style>
  <Style Selector="dc|DocumentControl[TabsLayout=Right] dc|DocumentTabStripItem">
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>

  <!-- The older native chrome shares accent brushes with tabs. Neutral surfaces keep text legible;
       the selected-tab edge and splitter/drop feedback carry the blue accent instead. -->
  <Style Selector="dc|ToolChromeControl /template/ Grid#PART_Grip">
    <Setter Property="MinHeight" Value="{DynamicResource DockHeaderHeight}" />
    <Setter Property="Background" Value="{DynamicResource DockSurfaceHeaderBrush}" />
  </Style>
  <Style Selector="dc|ToolChromeControl:active /template/ Grid#PART_Grip">
    <Setter Property="Background" Value="{DynamicResource DockSurfaceHeaderActiveBrush}" />
  </Style>
  <Style Selector="dc|ToolChromeControl /template/ TextBlock#PART_Title">
    <Setter Property="Margin" Value="{DynamicResource DockToolChromeTitleMargin}" />
    <Setter Property="Foreground" Value="{DynamicResource DockThemeForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="dc|ToolChromeControl /template/ Grid#PART_Grid">
    <Setter Property="Background" Value="{DynamicResource DockSeparatorBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>
  <Style Selector="dc|ToolChromeControl /template/ Button">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="{DynamicResource DockChromeButtonWidth}" />
    <Setter Property="Height" Value="{DynamicResource DockChromeButtonHeight}" />
    <Setter Property="Padding" Value="{DynamicResource DockChromeButtonPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource DockCornerRadiusSmall}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="dc|DocumentTabStripItem Button">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="{DynamicResource DockCloseButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DockCloseButtonSize}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="{DynamicResource DockCornerRadiusSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource DockChromeButtonForegroundBrush}" />
  </Style>
  <Style Selector="dc|DocumentTabStripItem Path#PART_ClosePath">
    <Setter Property="Fill" Value="{DynamicResource DockChromeButtonForegroundBrush}" />
  </Style>
  <Style Selector="dc|DocumentTabStrip[Orientation=Horizontal] /template/ Button#PART_ButtonCreate">
    <Setter Property="Width" Value="{DynamicResource DockTabItemMinHeight}" />
    <Setter Property="Height" Value="{DynamicResource DockTabItemMinHeight}" />
  </Style>
  <Style Selector="dc|HostWindowTitleBar">
    <Setter Property="Background" Value="{DynamicResource DockWindowChromeTitleBarBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DockWindowChromeForegroundBrush}" />
  </Style>
  <Style Selector="dc|ToolPinItemControl">
    <Setter Property="Foreground" Value="{DynamicResource DockTabForegroundBrush}" />
  </Style>
  <Style Selector="dc|ToolPinItemControl:pointerover">
    <Setter Property="Background" Value="{DynamicResource DockTabHoverBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DockTabActiveForegroundBrush}" />
  </Style>

  <!-- Do not reduce the native splitter hit area or overwrite its model-driven resize policy. -->
  <Style Selector="split|ProportionalStackPanelSplitter">
    <Setter Property="Background" Value="{DynamicResource DockSplitterIdleBrush}" />
  </Style>
  <Style Selector="split|ProportionalStackPanelSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource DockSplitterHoverBrush}" />
  </Style>
  <Style Selector="split|ProportionalStackPanelSplitter:pressed, split|ProportionalStackPanelSplitter:preview">
    <Setter Property="Background" Value="{DynamicResource DockSplitterDragBrush}" />
  </Style>
</Styles>
