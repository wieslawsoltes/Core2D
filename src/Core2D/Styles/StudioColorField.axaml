<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="using:Core2D.Controls.Studio"
                    xmlns:cp="using:ThemeEditor.Controls.ColorPicker" x:CompileBindings="True">
  <ControlTheme x:Key="{x:Type s:StudioColorField}" TargetType="s:StudioColorField" x:DataType="s:StudioColorField">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
          <ToggleButton Name="PART_Swatch" Width="30" Height="28" Padding="3" CornerRadius="5"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        IsChecked="{TemplateBinding IsOpen, Mode=TwoWay}" AutomationProperties.Name="Open color picker">
            <Panel>
              <s:StudioCheckerboard />
              <Border Name="PART_SwatchColor" CornerRadius="2" Background="{TemplateBinding SwatchBrush}" />
            </Panel>
          </ToggleButton>
          <s:StudioHexField Name="PART_Hex" Grid.Column="1" Value="{Binding Hex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            AutomationProperties.Name="Hex color" />
          <s:StudioNumericField Grid.Column="2" Grid.ColumnSpan="2" Width="78" Prefix="" Suffix="%" Minimum="0" Maximum="100"
                                Value="{Binding OpacityPercent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                AutomationProperties.Name="Color opacity percent" />
          <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}" IsLightDismissEnabled="True"
                 Placement="BottomEdgeAlignedRight" PlacementTarget="{Binding #PART_Swatch}">
            <Border Background="{DynamicResource StudioSurfaceBrush}" BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12">
              <StackPanel Width="264" Spacing="10">
                <TextBlock Text="Custom color" FontWeight="SemiBold" />
                <s:StudioColorEditor Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                <Separator />
                <TextBlock Text="Presets" FontWeight="SemiBold" />
                <s:StudioColorPalette Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="Color presets" />
                <s:StudioSection Header="Advanced picker" IsExpanded="False" Padding="0" BorderThickness="0">
                  <cp:ColorPicker Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                </s:StudioSection>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
