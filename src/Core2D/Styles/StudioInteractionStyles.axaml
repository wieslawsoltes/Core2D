<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:editor="using:Core2D.Controls.Editor" xmlns:s="using:Core2D.Controls.Studio">
  <!-- These container themes must follow the generic item theme; Avalonia uses style order. -->
  <Style Selector="s|StudioSegmentedControl ListBoxItem, s|StudioColorPalette ListBoxItem">
    <Setter Property="Theme" Value="{StaticResource StudioSegmentItemTheme}"/>
  </Style>
  <Style Selector="s|StudioAnchorPicker ListBoxItem">
    <Setter Property="Theme" Value="{StaticResource StudioAnchorItemTheme}"/>
    <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Menu &gt; MenuItem /template/ Popup#PART_Popup"><Setter Property="Placement" Value="BottomEdgeAlignedLeft"/></Style>
  <Style Selector="editor|MenuView.studio-command-menu Menu &gt; MenuItem /template/ Popup#PART_Popup"><Setter Property="Placement" Value="RightEdgeAlignedTop"/></Style>
</Styles>
