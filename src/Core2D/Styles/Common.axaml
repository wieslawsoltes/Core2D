<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FontFamily x:Key="UiFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="CodeFontFamily">avares://Core2D/Assets/Fonts#Roboto Mono</FontFamily>
    <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="UiFontFamily"/>
    <StaticResource x:Key="BrowserFontFamily" ResourceKey="UiFontFamily"/>
  </Styles.Resources>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
  </Style>

  <StyleInclude Source="avares://ThemeEditor.Controls.ColorPicker/ColorPicker.axaml"/>
  <StyleInclude Source="avares://Dock.Avalonia.Themes.Fluent/DockFluentTheme.axaml"/>
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.v2.xaml"/>
  <StyleInclude Source="avares://Core2D/Styles/Geometry.axaml"/>
  <StyleInclude Source="avares://Core2D/Styles/Icons.axaml"/>
  <StyleInclude Source="avares://Core2D/Styles/Dock.axaml"/>
  <StyleInclude Source="avares://Core2D/Controls/EditableItem.axaml"/>
  <StyleInclude Source="avares://Core2D/Controls/ToggleItem.axaml"/>
  <StyleInclude Source="avares://Core2D.Controls.Ruler/Controls/Ruler.axaml"/>

  <!-- Text inherits its control's foreground, including selected, disabled and primary-button states. -->
</Styles>
