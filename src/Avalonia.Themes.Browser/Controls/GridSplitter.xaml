<!-- Derived from AvaloniaUI/Avalonia 11.3.12 (MIT). See LICENSE.Avalonia.txt and UpstreamManifest.json. --><ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter" x:DataType="GridSplitter">
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="MinHeight" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource BrowserBorderBrush}"/>
      <Setter Property="PreviewContent">
        <Template>
          <Rectangle Fill="{DynamicResource SystemAccentColor}"/>
        </Template>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
        </ControlTemplate>
      </Setter>
    <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource BrowserAccentBrush}"/></Style></ControlTheme>
</ResourceDictionary>
